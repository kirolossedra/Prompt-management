# The application already includes the supplied Firebase project as a fallback.
# Set these only when deploying against a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Netlify Function variables. Never prefix GEMINI_API_KEY with VITE_.
# Configure GEMINI_API_KEY in Netlify's environment-variable UI rather than committing a real value.
GEMINI_API_KEY=
# Optional Semantic Prompt Finder model override; production defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=
# Optional Prompt Repurposer model override; production defaults to gemini-3.5-flash for higher transformation quality.
GEMINI_REPURPOSE_MODEL=
# Optional Prompt Mixer model override; production defaults to gemini-3.5-flash.
GEMINI_MIXER_MODEL=
# Optional Firebase Web API key override used only to verify signed-in Firebase ID tokens server-side.
FIREBASE_WEB_API_KEY=
# Optional Prompt Blocks per-block transformation model override; defaults to GEMINI_MIXER_MODEL or gemini-3.5-flash.
GEMINI_PROMPT_BLOCKS_MODEL=
