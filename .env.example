# The application already includes the supplied Firebase project as a fallback.
# Set these only when deploying against a different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Frontend -> Spring Boot API base URL, e.g. http://localhost:8080 in local development.
VITE_BACKEND_API_URL=

# Spring Boot Firebase Admin configuration.
# Keep the real service-account JSON only in local/server secret storage.
FIREBASE_ADMIN_ENABLED=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated browser origins allowed to call Spring Boot.
# Example local origin: http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=

# Server-side Netlify Function variables. Never prefix GEMINI_API_KEY with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REPURPOSE_MODEL=
GEMINI_MIXER_MODEL=
FIREBASE_WEB_API_KEY=
GEMINI_PROMPT_BLOCKS_MODEL=
